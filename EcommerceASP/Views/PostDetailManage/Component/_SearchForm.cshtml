@model EcommerceASP.ViewModel.PostDetailManage.SearchFormViewModel

@using (Ajax.BeginForm("GetList", "PostDetailManage", null,
									new AjaxOptions
									{
										HttpMethod = "POST",
										OnBegin = "Common.PostDetailManage.BeforeSend",
										OnSuccess = "Common.PostDetailManage.SuccessForm",
										UpdateTargetId = "list-data"
									}, new { @id = "form-search-PostDetailManage", @class = "form-horizontal multiple-controls", @style = "display:flex;flex-wrap:wrap" }))
{
	<div class="hidden">
		@Html.HiddenFor(m => m.PageCurrent)
	</div>
	<div class="col-sm-3 d-flex align-items-center flex-wrap p-0 mb-1">
		<label class="col-sm-3 control-label p-0">Loại bài viết:</label>
		<div class="col-sm-9 p-0">
			@Html.DropDownListFor(m => m.CategoryId, EcommerceASP.Queries.CommonQuery.GetCategoryTopic(Model.CategoryId), "==Tất cả==", new { @class = "w-100 form-control" })
		</div>
	</div>
	<div class="col-sm-3 d-flex align-items-center flex-wrap p-0 mb-1">
		<label class="col-sm-3 control-label p-0">Chủ đề bài viết:</label>
		<div class="col-sm-9 p-0">
			@Html.DropDownListFor(m => m.TopicId, EcommerceASP.Queries.CommonQuery.GetTopic(Model.TopicId), "==Tất cả==", new { @class = "w-100" })
		</div>
	</div>
	<div class="col-sm-3 d-flex align-items-center flex-wrap p-0 mb-1">
		<label class="col-sm-3 control-label p-0">Tiêu đề:</label>
		<div class="col-sm-9 p-0">
			@Html.TextBoxFor(m => m.Title, null, new { @class = "w-100 form-control", @placeholder = "Tiêu đề bài viết" })
		</div>
	</div>
	<div class="col-sm-3 d-flex align-items-center flex-wrap p-0 mb-1">
		<label class="col-sm-3 control-label p-0">Đường dẫn:</label>
		<div class="col-sm-9 p-0">
			@Html.TextBoxFor(m => m.Slug, null, new { @class = "w-100 form-control", @placeholder = "Đường dẫn" })
		</div>
	</div>
	<div class="col-sm-12 text-right">
		<button type="button" class="btn btn-danger btn-cons btn-sm" data-toggle="modal" data-target="#modal-update" data-backdrop="static" onclick="Common.PostDetailManage.ShowDialog()">
			<i class="fa fa-plus fa-lg"></i> &nbsp; Thêm mới
		</button>
		<button type="submit" class="btn btn-primary btn-sm">
			<i class="fa fa-search fa-lg"></i> &nbsp; Tìm kiếm
		</button>
		<button type="reset" class="btn btn-default btn-sm" @*onclick="Common.DialogTheme.Reset()"*@>
			<i class="fa fa-refresh fa-lg"></i> &nbsp; Xóa
		</button>
	</div>
}
<script>
	$(document).ready(function () {
		$("#CategoryId").off('select2:select').select2();
		$("#TopicId").off('select2:select').select2();
	});
</script>

