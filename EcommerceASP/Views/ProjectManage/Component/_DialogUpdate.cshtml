@model EcommerceASP.ViewModel.ProjectManage.ProjectManageBO
@{
	var controlDev = false;
}
@using (Ajax.BeginForm("Update", "ProjectManage", null, new AjaxOptions()
{
	HttpMethod = "POST",
	OnBegin = "Common.ProjectManage.UpdateBeforeSend",
	OnSuccess = "Common.ProjectManage.UpdateSuccess"
},
new
{
	@id = "form-update",
	@class = "form-horizontal multiple-controls",
	@enctype = "multipart/form-data"
}))
{
	<div class="hidden">
		@Html.HiddenFor(m => m.Id)
		@Html.AntiForgeryToken()
	</div>
	<div class="col-md-12 container">
		<div class="row form-group">
			<label class="control-label col-md-2">Tiêu đề:</label>
			<div class="col-md-10">
				@Html.TextBoxFor(m => m.Title, new { @class = "form-control", @maxLength = "150", @style = "height:30px" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2">Đường dẫn:</label>
			<div class="col-md-10">
				@Html.TextBoxFor(m => m.Slug, new { @class = "form-control", @maxLength = "150", @style = "height:30px" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2">Khách hàng:</label>
			<div class="col-md-10">
				@Html.TextBoxFor(m => m.Customer, new { @class = "form-control", @maxLength = "150", @style = "height:30px" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2">Diện tích:</label>
			<div class="col-md-10">
				@Html.TextBoxFor(m => m.Size, new { @class = "form-control", @maxLength = "150", @style = "height:30px" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2">Thời gian thực hiện:</label>
			<div class="col-md-10">
				@Html.TextBoxFor(m => m.TimeProject, new { @class = "form-control", @maxLength = "150", @style = "height:30px" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2">Địa chỉ:</label>
			<div class="col-md-10">
				@Html.TextBoxFor(m => m.Address, new { @class = "form-control", @maxLength = "150", @style = "height:30px" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2">Mô tả công việc:</label>
			<div class="col-md-10">
				@Html.TextBoxFor(m => m.JobDescription, new { @class = "form-control", @maxLength = "150", @style = "height:30px" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2 ">Hình:</label>
			<div class="col-md-9">
				<div class="input-group">
					<img id="imgShow" src="@Url.Content($"~/Content/Images/project/{Model.ThumbnailImage}")" alt="@Model.Title" height="50" />
				</div>
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2 ">Tải hình lên:</label>
			<div class="col-md-9">
				<div class="input-group">
					@Html.TextBoxFor(m => m.ThumbnailImage, new { @class = "form-control" })
					@Html.HiddenFor(m => m.ImageOld)
					<label class="input-group-addon cursor" for="file-upload-image">
						<i class="fa fa-upload"></i>
					</label>
				</div>
				<input type="file" id="file-upload-image" name="UploadImage" class="d-none" />
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2 ">Tải chi tiết hình ảnh:</label>
			<div class="col-md-9">
				<!--<div class="input-group">-->
				@*@Html.TextBoxFor(m => m.ThumbnailImage, new { @class = "form-control" })
				@Html.HiddenFor(m => m.ImageOld)*@
				<!--<span>Tên file nhé</span>
				<label class="input-group-addon cursor" for="file-upload-multiple">
					<i class="fa fa-upload"></i>
				</label>
			</div>-->
				<input type="file" id="file-upload-multiple" name="UploadMultiImage" multiple />
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2">Thứ tự:</label>
			<div class="col-md-10">
				@Html.TextBoxFor(m => m.Priority, new { @class = "form-control", @type = "number", @min = "0" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2">Nội dung:</label>
			<div class="col-md-10">
				@Html.TextAreaFor(m => m.Content, new { @class = "form-control", @rows = "5" })
				@{
					if (controlDev)
					{
						<script>
							var editor1 = CKEDITOR.replace("Content", {
								extraPlugins: 'image2,uploadimage',
								extraAllowedContent: 'div',
								toolbar: [{
									name: 'clipboard',
									items: ['Undo', 'Redo']
								},
								{
									name: 'styles',
									items: ['Styles', 'Format']
								},
								{
									name: 'basicstyles',
									items: ['Bold', 'Italic', 'Strike', '-', 'RemoveFormat']
								},
								{
									name: 'paragraph',
									items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote']
								},
								{
									name: 'links',
									items: ['Link', 'Unlink']
								},
								{
									name: 'insert',
									items: ['Image', 'Table']
								},
								{
									name: 'tools',
									items: ['Maximize']
								},
								{
									name: 'editing',
									items: ['Scayt']
								}
								],

								// Configure your file manager integration. This example uses CKFinder 3 for PHP.
								filebrowserBrowseUrl: '/apps/ckfinder/3.4.5/ckfinder.html',
								filebrowserImageBrowseUrl: '@Url.Content("~/Content/Images/project")',
								filebrowserUploadUrl: '@Url.Action("UploadImageProject", "Common")',
								filebrowserImageUploadUrl: '@Url.Action("UploadImageProject", "Common")',

								// Upload dropped or pasted images to the CKFinder connector (note that the response type is set to JSON).
								uploadUrl: '@Url.Action("UploadImageTopic", "Common")',

								// Reduce the list of block elements listed in the Format drop-down to the most commonly used.
								format_tags: 'p;h1;h2;h3;pre',
								// Simplify the Image and Link dialog windows. The "Advanced" tab is not needed in most cases.
								removeDialogTabs: 'image:advanced;link:advanced',

								height: 300,
								removeButtons: 'PasteFromWord',
							});
						</script>
					}
					else
					{
						<script>
							CKEDITOR.replace("Content", {
								filebrowserBrowseUrl: '#',
								filebrowserUploadUrl: '@Url.Action("UploadImageProject", "Common")',
							});
						</script>
					}
				}
			</div>
		</div>
	</div>
}
<script>
	$(document).ready(function () {
		$("#idpage").off('select2:select').select2();
	});
</script>