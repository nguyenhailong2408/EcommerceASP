@model EcommerceASP.ViewModel.Component.ComponentViewBO
@{ if (Model != null)
	{
		<section class="topic topic--option1">
			<h2 class="topic__title">
				<a href="#"><span class="topic__title-span">@Model.Title @*THIẾT KẾ NỘI THẤT*@</span></a>
			</h2>
			<div class="topic__content">
				@{
					if (Model.lstDetailComponent.Count > 0)
					{
						<div class="splide topic__content-slide topic-splide-s1" id="topic-splide-s@(Model.Id)" style="width:100%;">
							<div class="splide__track">
								<ul class="splide__list">
									@{
										var index = 0;
										foreach (var item in Model.lstDetailComponent)
										{
											<li class="splide__slide splide-item--product @(index==0?"--first":"")">
												<div class="__block--product">
													<div class="__item--product s-block--product">
														<div class="s-block__image--product box-image--product">
															<img class="box-image__image--product" style="height: auto;" src="@Url.Content($"~/Content/Images/{item.FolderImage}/{item.ImageName}")" />
														</div>
														<div class="s-block__boxinfo">
															<h3 class="s-block__boxinfo __title"><a href="/@item.Slug">@item.Title</a></h3>
															<div class="s-block__boxinfo __line"></div>
															<span class="s-block__boxinfo __description">@Html.Raw(item.Description)</span>
															<a href="/@item.Slug" class="s-block__boxinfo __link s-block__link--product">Xem chi tiết</a>
														</div>
													</div>
												</div>
											</li>
											index++;
										}
									}
								</ul>
							</div>
						</div>
						<div class="topic__content-showmore">
							<a href="/@(Model.ParentSlug)" class="btn btn-outline-warning">Xem thêm</a>
						</div>
						<script>
							$(document).ready(function () {
								new Splide("#topic-splide-s@(Model.Id)", {
									//type: 'loop',
									perPage: @(Model.Collumns),
									perMove: 1,
									focus: 'left',
									gap: '0px', //  gap between 2 slide
									pagination: false,
									//autoplay: true,
									//pauseOnHover: false,
									speed: 900,
									breakpoints: {
										2000: {
											perPage: @(Model.Collumns),
											gap: '0px'
										},
										1500: {
											perPage: @(Model.Collumns),
											gap: '0px'
										},
										1200: {
											perPage: 3,
											gap: '0px'
										},
										960: {
											perPage: 2,
											gap: '0px'
										},
										640: {
											perPage: 2,
											gap: '0px'
										},
										400: {
											perPage: 2,
										},
									}
								}).mount();
							});
						</script>
					}
				}
			</div>
		</section>
	}
}