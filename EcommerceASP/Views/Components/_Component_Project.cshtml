@model EcommerceASP.ViewModel.ComponentPageSlug.ComponentTemplateViewBO
@*@section Scripts{
		<link rel="stylesheet" href="~/Content/css/component.css" />
	}*@
<link rel="stylesheet" href="~/Content/css/component_Project.css" />
@{
	var lstSubDescription = Model.lstComponentSubDescription;
	if (lstSubDescription != null && lstSubDescription.Count > 0)
	{
		<div class="componentProject drop-up">
			<div class="d-flex flex-wrap">
				@{
					foreach (var subDescription in lstSubDescription)
					{
						<div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 p-0 drop-up">
							<a href="@(string.IsNullOrEmpty(subDescription.ReferenceLink)?"#":subDescription.ReferenceLink)"
							   class="project__block">
								<div class="project__block__image position-relative">
									@*<img src="@Url.Content($"~/Content/Images/component/{subDescription.Image}")" alt="Alternate Text" />*@
									<div class="project__image" style="background-image: url('@Url.Content($"~/Content/Images/component/{subDescription.Image}")');">
									</div>
								</div>
								<div class="project__block__caption">
									<div class="project__block__caption--content">
										<div class="project__block__caption--category"> @subDescription.SubTitle</div>
										<div class="project__block__caption--name"><span>KHÁCH HÀNG:</span> @subDescription.Title</div>
									</div>
								</div>
							</a>
						</div>
					}
				}
			</div>
		</div>
	}
}

