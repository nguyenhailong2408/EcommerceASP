@model EcommerceASP.ViewModel.ComponentPageSlug.ComponentTemplateViewBO

<link rel="stylesheet" href="~/Content/css/common_style.css" />
@{
    var subDescription = Model.lstComponentSubDescription.FirstOrDefault();
    if (subDescription != null)
    {
        <div class="d-flex flex-wrap componentCustom__1">
            <div class="col-lg-6 col-md-6 col-sm-12 component__content--left content__image reveal fade-left">
                <img src="@Url.Content($"~/Content/Images/component/{subDescription.Image}")" alt="Alternate Text" style="width:100%;height:auto;" />
            </div>
            <div class="col-lg-6 col-md-6 col-sm-12 component__content--right pad__left__right__3__per reveal fade-right">
                <h4 class="content-right__title text__left"><strong>@subDescription.Title</strong></h4>
                <div class="dash style-dark default width__100__per"></div>
                <div class="content-right__modifi text__justify">
                    @Html.Raw(subDescription.Description)
                </div>
            </div>
        </div>
    }
}

