@model EcommerceASP.ViewModel.ComponentPageSlug.ComponentTemplateViewBO

<link rel="stylesheet" href="~/Content/css/component_three_content.css" />
@{

        var subDescription = Model.lstComponentSubDescription.Count;
        var component = Model.lstComponentSubDescription;

        if (subDescription == 2 )
        {
            <div class="component__two__content reveal fade-bottom col-sm-12">
                <div class="container d-flex flex-wrap">
                    @for (int index = 0; index < 2; index++)
                    {
                        if (component.ElementAt(index).Title != null)
                        {
                            <div class="col-lg-6 col-md-6 col-sm-12">
                                <h2 style="text-align: center; font-weight: 500; margin-top: 30px; "><span>@component.ElementAt(index).Title</span></h2>
                                <div style="margin: auto;" class="dash style-dark default"></div>
                            </div>
                        }
                        else
                        {
                            <div class="col-lg-6 col-md-6 col-sm-12">
                                <p style="text-align: justify;">@Html.Raw(component.ElementAt(index).Description)</p>
                            </div>
                        }
                    }
                </div>
            </div>
        }
}
