@model EcommerceASP.ViewModel.CategoryManage.CategoryManageBO
@{
	var controlDev = EcommerceASP.Constaint.Common.ControlCKEditor;
}
@using (Ajax.BeginForm("Update", "CategoryManage", null, new AjaxOptions()
{
	HttpMethod = "POST",
	OnBegin = "Common.CategoryManage.UpdateBeforeSend",
	OnSuccess = "Common.CategoryManage.UpdateSuccess"
},
new
{
	@id = "form-update",
	@class = "form-horizontal multiple-controls",
	@enctype = "multipart/form-data"
}))
{
	<div class="hidden">
		@Html.HiddenFor(m => m.Id)
		@Html.AntiForgeryToken()
	</div>
	<div class="col-md-12 container">
		<div class="row form-group">
			<label class="control-label col-md-12 font-weight-bold">Tiêu đề: <span style="color:red;">(*)</span></label>
			<div class="col-md-12">
				@Html.TextBoxFor(m => m.Name, new { @class = "form-control", @maxLength = "150", @style = "height:30px" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-12 font-weight-bold">Đường dẫn: <span style="color:red;">(*)</span></label>
			<div class="col-md-12">
				@Html.TextBoxFor(m => m.Slug, new
		   {
			   @class = "form-control",
			   @maxLength = "150",
			   @style = "height:30px",
			   @onblur = "Common.CategoryManage.OnBlurInputSlug(this)"
		   })
			</div>
			<span style="color:red">Lưu ý: (Bắt buộc) Đường dẫn phải đã được tạo sẵn trước đó ở các mục: (Danh mục sản phẩm, Sản phẩm, Bài viết, Chủ đề bải viết...)</span>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-12 font-weight-bold">Trang:</label>
			<div class="col-md-12">
				@Html.DropDownListFor(m => m.PageId,
										   EcommerceASP.Queries.CommonQuery.GetListPage(Model.PageId),
										   "-- Chưa chọn trang --",
										   new { @class = "form-control", @readonly = "readonly" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-12 font-weight-bold">Thứ tự:</label>
			<div class="col-md-12">
				@Html.TextBoxFor(m => m.Priority, new { @class = "form-control", @type = "number", @min = "0" })
			</div>
			<span style="color:red">Ghi chú: Sắp xếp trên giao diện menu từ trái => phải, nhỏ => lớn</span>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-12 font-weight-bold">Folder Hình:</label>
			<div class="col-md-12">
				@Html.TextBoxFor(m => m.FolderImage, new { @class = "form-control", @type = "text" })
			</div>
			<span style="color:red">Ghi chú: Không cần nhập</span>
		</div>
	</div>
}
<script>
	$(document).ready(function () {
	});
</script>