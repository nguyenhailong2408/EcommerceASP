@{
	var ControllerName = ViewContext.RouteData.Values["Controller"];
	var ActionName = ViewContext.RouteData.Values["Action"];
}
<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>@ViewBag.Title</title>
	@*@Styles.Render("~/Content/css")*@
	@Styles.Render("~/Content/themes/regular/css")
	@Styles.Render("~/Content/themes/regular/loading")
	@Scripts.Render("~/bundles/modernizr")
	@Scripts.Render("~/bundles/jquery")

	@Scripts.Render("~/UI/slimScroll/javascripts")
	@Scripts.Render("~/UI/microsoft/ajax/javascripts")

	<!-- Bootstrap -->
	@Scripts.Render("~/bundles/bootstrap")
	<!-- slider -->
	@Styles.Render("~/UI/slider/css")
	@Scripts.Render("~/UI/slider/js")

	<!-- select2 -->
	@Styles.Render("~/UI/select2/css")
	@Scripts.Render("~/UI/select2/js")

	@Scripts.Render("~/bundles/timepicker/js")
	@Styles.Render("~/bundles/timepicker/css")

	<link href="~/UI/zoomify/zoomify.css" rel="stylesheet" />
	<script src="~/UI/zoomify/zoomify.js"></script>

	@*<script src="https://cdn.ckeditor.com/4.20.0/standard-all/ckeditor.js"></script>*@
	<script src="https://cdn.ckeditor.com/4.20.0/full/ckeditor.js"></script>
	@*<script src="~/UI/ckeditor/Themes/ckeditor.js"></script>*@
	<script src="~/UI/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>
	<link rel="stylesheet" href="~/UI/bootstrap-datepicker/css/bootstrap-datepicker3.css">

	<!-- Font Awesome -->
	<link rel="stylesheet" href="~/UI/font-awesome/css/font-awesome.min.css">
	<link rel="stylesheet" href="~/UI/bootstrap-4.3.1/css/bootstrap.min.css">

	@*<link href="~/UI/zoomify/zoomify.css" rel="stylesheet" />
		<script src="~/UI/zoomify/zoomify.js"></script>*@

	@RenderSection("scripts", required: false)
	<script src="~/Scripts/Common.js"></script>
	<link rel="stylesheet" href="~/UI/admin/simplebar.css">
	<link rel="stylesheet" href="~/UI/admin/examples.css">
	<link rel="stylesheet" href="~/UI/admin/style.css">
	<link rel="stylesheet" href="~/Content/layout.css">
	<link rel="stylesheet" href="~/Content/site.css">
</head>
<body>
	<div class="loading" id="show-loading">
		@{
			Html.RenderPartial("Loading");
		}
	</div>
	<div class="modal-popup">
		@{
			Html.RenderPartial("Alert");
		}
	</div>
	<div class="sidebar sidebar-dark sidebar-fixed" id="sidebar">
		<div class="sidebar-brand d-none d-md-flex">
			<a href="/"><img src="~/Content/Images/logoThuanPhat.png" alt="" style="height:30px;" /></a>
		</div>
		<ul class="sidebar-nav" data-coreui="navigation" data-simplebar="">
			<li class="nav-item">
				<a class="nav-link" href="index">
					<svg class="nav-icon">
						<use xlink:href="~/UI/admin/vendors/coreui/icons/svg/free.svg#cil-speedometer"></use>
					</svg> Dashboard<span class="badge badge-sm bg-info ms-auto">NEW</span>
				</a>
			</li>
			<li class="nav-title">Quản lý</li>
			<li class="nav-group">
				<a class="nav-link nav-group-toggle" href="#">
					<svg class="nav-icon">
						<use xlink:href="~/UI/admin/vendors/coreui/icons/svg/free.svg#cil-star"></use>
					</svg> Pages
				</a>
				<ul class="nav-group-items">
					<li class="nav-item @(ControllerName.Equals("pageslug")?"active":"")">
						<a class="nav-link" href="@Url.Action("Index","PageSlug")"><span class="nav-icon"></span> Đường dẫn</a>
					</li>
				</ul>
			</li>
			<li class="nav-group">
				<a class="nav-link nav-group-toggle" href="#">
					<svg class="nav-icon">
						<use xlink:href="~/UI/admin/vendors/coreui/icons/svg/free.svg#cil-star"></use>
					</svg> Danh mục Menu
				</a>
				<ul class="nav-group-items">
					<li class="nav-item @(ControllerName.Equals("categorymanage")?"active":"")">
						<a class="nav-link" href="@Url.Action("Index","CategoryManage")"><span class="nav-icon"></span> Danh mục cha</a>
					</li>
					<li class="nav-item @(ControllerName.Equals("categorydetailmanage")?"active":"")">
						<a class="nav-link" href="@Url.Action("Index","CategoryDetailManage")"><span class="nav-icon"></span> Danh mục con</a>
					</li>
				</ul>
			</li>
			<li class="nav-group">
				<a class="nav-link nav-group-toggle" href="#">
					<svg class="nav-icon">
						<use xlink:href="~/UI/admin/vendors/coreui/icons/svg/free.svg#cil-star"></use>
					</svg> Danh mục sản phẩm
				</a>
				<ul class="nav-group-items">
					<li class="nav-item @(ControllerName.Equals("productcategorymanage")?"active":"")">
						<a class="nav-link" href="@Url.Action("Index","ProductCategoryManage")"><span class="nav-icon"></span> Danh mục cha</a>
					</li>
					<li class="nav-item @(ControllerName.Equals("productcategorydetailmanage")?"active":"")">
						<a class="nav-link" href="@Url.Action("Index","ProductCategoryDetailManage")"><span class="nav-icon"></span> Danh mục con</a>
					</li>
				</ul>
			</li>
			<li class="nav-item @(ControllerName.Equals("productmanage")?"active":"")">
				<a class="nav-link" href="@Url.Action("Index","ProductManage")">
					<svg class="nav-icon">
						<use xlink:href="~/UI/admin/vendors/coreui/icons/svg/free.svg#cil-star"></use>
					</svg> Sản phẩm
				</a>
			</li>
			<li class="nav-group">
				<a class="nav-link nav-group-toggle" href="#">
					<svg class="nav-icon">
						<use xlink:href="~/UI/admin/vendors/coreui/icons/svg/free.svg#cil-star"></use>
					</svg> Bài viết
				</a>
				<ul class="nav-group-items">
					<li class="nav-item @(ControllerName.Equals("postmanage")?"active":"")">
						<a class="nav-link" href="@Url.Action("Index","PostManage")"><span class="nav-icon"></span>Chủ đề bài viết</a>
					</li>
					<li class="nav-item @(ControllerName.Equals("postdetailmanage")?"active":"")">
						<a class="nav-link" href="@Url.Action("Index","PostDetailManage")"><span class="nav-icon"></span>Bài viết</a>
					</li>
				</ul>
			</li>
			<li class="nav-item @(ControllerName.Equals("slidemanage")?"active":"")">
				<a class="nav-link" href="@Url.Action("Index","SlideManage")">
					<svg class="nav-icon">
						<use xlink:href="~/UI/admin/vendors/coreui/icons/svg/free.svg#cil-star"></use>
					</svg> Slide
				</a>
			</li>
			<li class="nav-group">
				<a class="nav-link nav-group-toggle" href="#">
					<svg class="nav-icon">
						<use xlink:href="~/UI/admin/vendors/coreui/icons/svg/free.svg#cil-star"></use>
					</svg> Module
				</a>
				<ul class="nav-group-items">
					<li class="nav-item @(ControllerName.Equals("componenttypemanage")?"active":"")">
						<a class="nav-link" href="@Url.Action("Index","ComponentTypeManage")"><span class="nav-icon"></span> Loại Module</a>
					</li>
					@*<li class="nav-item @(ControllerName.Equals("componentmanage")?"active":"")">
						<a class="nav-link" href="@Url.Action("Index","ComponentManage")"><span class="nav-icon"></span> Module</a>
					</li>*@
					<li class="nav-item @(ControllerName.Equals("componentpageslug")?"active":"")">
						<a class="nav-link" href="@Url.Action("Index","ComponentPageSlug")"><span class="nav-icon"></span> Module theo đường dẫn</a>
					</li>
				</ul>
			</li>
		</ul>
		<button class="sidebar-toggler" type="button" data-coreui-toggle="unfoldable"></button>
	</div>
	<div class="wrapper d-flex flex-column min-vh-100 bg-light">
		<header class="header header-sticky mb-4" style="margin:0!important;">
			<div class="container-fluid">
				<button class="header-toggler px-md-0 me-md-3" type="button" onclick="coreui.Sidebar.getInstance(document.querySelector('#sidebar')).toggle()">
					<svg class="icon icon-lg">
						<use xlink:href="~/UI/admin/vendors/coreui/icons/svg/free.svg#cil-menu"></use>
					</svg>
				</button>
				<ul class="header-nav d-none d-md-flex">
					<li class="nav-item"><a class="nav-link" href="@Url.Action("Index","CategoryManage")">Danh mục Menu</a></li>
					<li class="nav-item"><a class="nav-link" href="@Url.Action("Index","ProductCategoryManage")">Danh mục sản phẩm</a></li>
					<li class="nav-item"><a class="nav-link" href="@Url.Action("Index","ProductManage")">Sản phẩm</a></li>
					<li class="nav-item"><a class="nav-link" href="@Url.Action("Index","PostManage")">Bài viết</a></li>
					<li class="nav-item"><a class="nav-link" href="@Url.Action("Index","SlideManage")">Slide</a></li>
				</ul>
				<ul class="header-nav ms-auto">
					<li class="nav-item">
						<a class="nav-link" href="#">
							<svg class="icon icon-lg">
								<use xlink:href="~/UI/admin/vendors/coreui/icons/svg/free.svg#cil-bell"></use>
							</svg>
						</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" href="#">
							<svg class="icon icon-lg">
								<use xlink:href="~/UI/admin/vendors/coreui/icons/svg/free.svg#cil-list-rich"></use>
							</svg>
						</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" href="#">
							<svg class="icon icon-lg">
								<use xlink:href="~/UI/admin/vendors/coreui/icons/svg/free.svg#cil-envelope-open"></use>
							</svg>
						</a>
					</li>
				</ul>
				<ul class="header-nav ms-3">
					<li class="nav-item dropdown">
						<a class="nav-link py-0" data-coreui-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">
							<div class="avatar avatar-md">
								<img class="avatar-img" src="~/Content/Images/logoThuanPhat.png" alt="user@email.com">
							</div>
						</a>
						<div class="dropdown-menu dropdown-menu-end pt-0">
							@*<div class="dropdown-header bg-light py-2">
									<div class="fw-semibold">Settings</div>
								</div>*@
							<a class="dropdown-item" href="#">
								<svg class="icon me-2">
									<use xlink:href="~/UI/admin/vendors/coreui/icons/svg/free.svg#cil-user"></use>
								</svg> Profile
							</a>
							<a class="dropdown-item" href="#">
								<svg class="icon me-2">
									<use xlink:href="~/UI/admin/vendors/coreui/icons/svg/free.svg#cil-settings"></use>
								</svg> Settings
							</a>
							<div class="dropdown-divider"></div>
							<a class="dropdown-item" href="@Url.Action("Logout","Account")">
								<svg class="icon me-2">
									<use xlink:href="~/UI/admin/vendors/coreui/icons/svg/free.svg#cil-account-logout"></use>
								</svg> Logout
							</a>
						</div>
					</li>
				</ul>
			</div>
			@*<div class="header-divider"></div>*@
			<!--<div class="container-fluid">
			<nav aria-label="breadcrumb">
				<ol class="breadcrumb my-0 ms-2">
					<li class="breadcrumb-item">-->
			<!-- if breadcrumb is single-->
			<!--<span>Home</span>
						</li>
						<li class="breadcrumb-item active"><span>Dashboard</span></li>
					</ol>
				</nav>
			</div>-->
		</header>
		<div class="body flex-grow-1 px-3">
			<content class="container-lg">
				@RenderBody()
			</content>
		</div>
		<footer class="footer">
			<div>© 2022 creativeLabs.</div>
			<div class="ms-auto">Powered by&nbsp;Thuận Phát</div>
		</footer>

		<div id="footer-container-move" style="position:fixed;display: none;z-index:20;right:10px;bottom:10px;font-size:26px;">
			<div class="footer-container-move-up">
				<a title="Top" href="javascript: void(0);" onclick="$('html, body').animate({scrollTop: 0}, 600);">
					<span class="glyphicon glyphicon-circle-arrow-up"></span>
				</a>
			</div>
			<div class="footer-container-move-down">
				<a title="Bottom" href="javascript: void(0);" onclick="$('html, body').animate({scrollTop: $(document).height()}, 600);">
					<span class="glyphicon glyphicon-circle-arrow-down"></span>
				</a>
			</div>
		</div>
	</div>
	<!-- CoreUI and necessary plugins-->
	<script src="~/UI/admin/vendors/coreui/coreui/js/coreui.bundle.min.js"></script>
	<script src="~/UI/admin/vendors/simplebar/js/simplebar.min.js"></script>
	<!-- Plugins and scripts required by this view-->
	<script src="~/UI/admin/vendors/chart.js/js/chart.min.js"></script>
	<script src="~/UI/admin/vendors/coreui/chartjs/js/coreui-chartjs.js"></script>
	<script src="~/UI/admin/vendors/coreui/utils/js/coreui-utils.js"></script>
	@*<script src="js/main.js"></script>*@
	<script>
		$('.modal').attr('tabindex', '');
	</script>
</body>
</html>