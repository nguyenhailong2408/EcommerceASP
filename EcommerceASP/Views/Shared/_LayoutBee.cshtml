<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>@ViewBag.Title</title>
	@*@Styles.Render("~/Content/css")*@
	@Styles.Render("~/Content/themes/regular/css")
	@Styles.Render("~/Content/themes/regular/loading")
	@*@Scripts.Render("~/bundles/modernizr")*@
	@Scripts.Render("~/bundles/jquery")

	@Scripts.Render("~/UI/microsoft/ajax/javascripts")

	<!-- Bootstrap -->
	@Scripts.Render("~/bundles/bootstrap")
	<!-- slider -->
	@Styles.Render("~/UI/slider/css")
	@Scripts.Render("~/UI/slider/js")

	@Scripts.Render("~/bundles/timepicker/js")
	@Styles.Render("~/bundles/timepicker/css")
	<!-- FancyBox-->
	@*@Scripts.Render("~/UI/fancybox_fancybox/js")
		@Styles.Render("~/UI/fancybox_fancybox/css")*@
	<script src="~/UI/fancybox_fancybox/fancybox_fancybox.js"></script>
	<link rel="stylesheet" href="~/UI/fancybox_fancybox/fancybox_fancybox.css" />

	<script src="~/UI/fancybox_fancybox/fancybox_carousel.js"></script>
	<link rel="stylesheet" href="~/UI/fancybox_fancybox/fancybox_carousel.css" />

	<script src="~/UI/fancybox_fancybox/fancybox_carousel_thumbs.js"></script>
	<link rel="stylesheet" href="~/UI/fancybox_fancybox/fancybox_carousel_thumbs.css" />

	<script src="~/UI/fancybox_fancybox/fancybox_carousel_autoplay.js"></script>
	<link rel="stylesheet" href="~/UI/fancybox_fancybox/fancybox_carousel_autoplay.css" />

	<script src="~/UI/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>
	<link rel="stylesheet" href="~/UI/bootstrap-datepicker/css/bootstrap-datepicker3.css">

	<!-- Font Awesome -->
	<link rel="stylesheet" href="~/UI/font-awesome/css/font-awesome.min.css">
	<link rel="stylesheet" href="~/UI/bootstrap-4.3.1/css/bootstrap.min.css">
	<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
	<link rel="stylesheet" href="https://cdn.linearicons.com/free/1.0.0/icon-font.min.css">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
	@*<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>*@
	<script src="//cdnjs.cloudflare.com/ajax/libs/jquery.nicescroll/3.5.1/jquery.nicescroll.min.js"></script>

	@RenderSection("scripts", required: false)
	<script src="~/Scripts/Common.js"></script>
	<link rel="stylesheet" href="~/Content/css/main.css" />
	<link rel="stylesheet" href="~/Content/css/mainBee.css" />
	<link rel="stylesheet" href="~/Content/css/menu.css">
	@*<link rel="stylesheet" href="~/Content/css/mmenu.css">*@
	<link rel="stylesheet" href="~/Content/css/responsive.css">
	<link rel="stylesheet" href="~/Content/css/footer.css" />


</head>
<body>


	<section id="headerBee" class="header" style="position: sticky; z-index: 3;">
		@{Html.RenderAction("MenuMobileCategory", "Home"); }
		@{
			//Html.RenderPartial("Components/_Menu");
			Html.RenderAction("MenuCategory", "Home");

		}
	</section>

	<content class="body-content" style="margin: 0;">
		@RenderBody()
	</content>
	<div class="fixed-right">
		<a target="_blank" href="https://www.facebook.com/messages/t/102522022650028" title="Facebook">
			<img src="@Url.Content("~/Content/Images/iconfb.png")" alt="icon">
		</a>
		<a target="_blank" href="https://zalo.me/0931166921" title="Zalo">
			<img src="@Url.Content("~/Content/Images/iconzalo.png")" alt="icon">
		</a>
		<a href="tel:0931166921" title="0931166921" class="phone">
			<img src="@Url.Content("~/Content/Images/iconphone.png")" alt="icon">
		</a>
	</div>
	<div id="wrapper" style=" position: fixed; right: 15px; bottom: 100px; cursor:pointer;z-index:9999">
		<div id="back_to_top" onclick="ClickToTop()" style="display:none;width: 40px; height: 40px; border-radius: 50%; border: 2px solid rgb(255, 255, 255); box-shadow: rgba(19, 19, 19, 0.3) 0px 0px 10px; background: rgba(70, 70, 70, 0.84);">
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
				 fill="currentColor"
				 class="bi bi-chevron-up"
				 viewBox="0 0 16 16"
				 style=" top: 25%; left: 25%; position: absolute; color: white; font-weight: bold;">
				<path fill-rule="evenodd" d="M7.646 4.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1-.708.708L8 5.707l-5.646 5.647a.5.5 0 0 1-.708-.708l6-6z" />
			</svg>
		</div>
	</div>
	<div class="modal-popup">
		@{
			Html.RenderPartial("Alert");
		}
	</div>
	<footer>
		@{
			Html.RenderPartial("Components/BeeDecor/_BeeTopFooter");
			Html.RenderPartial("Components/BeeDecor/_BeeFooter");
		}
	</footer>
	<script>
		$(window).scroll(function () {

			position = $(window).scrollTop();
			vitri = $('#content-Footer').offset().top - 500;
			if ($(this).scrollTop() > 300 && $(this).scrollTop() < vitri) {
				$('#back_to_top').fadeIn();
			}
			else if ($(this).scrollTop() > vitri) {
			}
			else {
				$('#back_to_top').fadeOut();
			}

		});
		$(window).on('beforeunload', function () {
			$(window).scrollTop(0);
		});
		function ClickToTop() {
			$('html, body').animate({ scrollTop: 0 }, 1000);
		};
		$(document).ready(function () {
			function reveal() {
				var reveals = document.querySelectorAll(".reveal");

				for (var i = 0; i < reveals.length; i++) {
					var windowHeight = window.innerHeight;
					var elementTop = reveals[i].getBoundingClientRect().top;
					var elementVisible = 150;

					if (elementTop < windowHeight - elementVisible) {
						reveals[i].classList.add("active");
					} else {
						reveals[i].classList.remove("active");
					}
				}
			}

			window.addEventListener("scroll", reveal);
		});
		$("html").niceScroll({
			scrollspeed: 120,
			mousescrollstep: 38,
			cursorwidth: 10,
			cursorborder: 0,
			cursorcolor: '#02020278',
			cursorborderradius: 10,
			autohidemode: true,
			horizrailenabled: false });
	</script>
</body>
</html>