@model EcommerceASP.ViewModel.ProductCategoryManage.SearchFormViewModel
@{
	Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
@{
	ViewBag.Title = "Quản lý danh mục sản phẩm";
}
@section Scripts{
	<script src="~/Scripts/Admin/ProductCategoryManage.js"></script>
}

<div class="box box-success">
	<div class="box-header with-border">
		<div class="col-sm-12 col-md-3">
			<div class="row">
				<h3 class="box-title">Danh mục sản phẩm cha</h3>
			</div>
		</div>
	</div><!-- /.box-header -->
	<div class="box-body">
		@{Html.RenderPartial("Component/_SearchForm", Model);}
	</div><!-- /.box-body -->
</div><!-- /.box -->

<div class="row">
	<div class="col-sm-12">
		<div class="box box-info">
			<div class="box-header with-border">
				<div class="col-sm-12 col-md-6">
					<div class="row">
						<h3 class="box-title">Danh sách danh mục sản phẩm</h3>
					</div>
				</div>
			</div><!-- /.box-header -->
			<div class="box-body" id="list-data" @*style="overflow-x: scroll;"*@>
			</div><!-- /.box-body -->
		</div><!-- /.box -->
	</div>
</div>
@{
	Html.RenderPartial("Components/_ModalUpdate");
}
<script>
	$(document).ready(function () {
		Common.ProductCategoryManage = new ProductCategoryManage();
		Common.ProductCategoryManage.SubmitForm();
		ProductCategoryManage.Url = {};
		ProductCategoryManage.Url.FormUpdate = '@Url.Action("Dialog","ProductCategoryManage")';
		ProductCategoryManage.Url.Delete = '@Url.Action("Delete", "ProductCategoryManage")';
		ProductCategoryManage.Url.GetPageBySlug = '@Url.Action("GetPageBySlug", "Common")';
	});
</script>