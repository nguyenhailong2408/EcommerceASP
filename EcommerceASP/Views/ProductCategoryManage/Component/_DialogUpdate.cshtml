@model EcommerceASP.ViewModel.ProductCategoryManage.ProductCategoryManageBO
@{
	var controlDev = EcommerceASP.Constaint.Common.ControlCKEditor;
}
@using (Ajax.BeginForm("Update", "ProductCategoryManage", null, new AjaxOptions()
{
	HttpMethod = "POST",
	OnBegin = "Common.ProductCategoryManage.UpdateBeforeSend",
	OnSuccess = "Common.ProductCategoryManage.UpdateSuccess"
},
new
{
	@id = "form-update",
	@class = "form-horizontal multiple-controls",
	@enctype = "multipart/form-data"
}))
{
	<div class="hidden">
		@Html.HiddenFor(m => m.Id)
		@Html.HiddenFor(m => m.SlugOld)
		@Html.AntiForgeryToken()
	</div>
	<div class="col-md-12 container">
		<div class="row form-group">
			<label class="control-label col-md-3">Tên danh mục: <span style="color:red">(*)</span></label>
			<div class="col-md-9">
				@Html.TextBoxFor(m => m.Name, new { @class = "form-control", @maxLength = "150", @style = "height:30px" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-3">Đường dẫn: <span style="color:red">(*)</span></label>
			<div class="col-md-9">
				@Html.TextBoxFor(m => m.Slug, new
		   {
			   @class = "form-control",
			   @maxLength = "150",
			   @style = "height:30px",
			   @onblur = "Common.ProductCategoryManage.OnBlurInputSlug(this)"
		   })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-3">Trang:</label>
			<div class="col-md-9">
				@Html.DropDownListFor(m => m.PageId,
										   EcommerceASP.Queries.CommonQuery.GetListPage(Model.PageId),
										   new { @class = "form-control", @readonly = "readonly" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-3">Thứ tự:</label>
			<div class="col-md-9">
				@Html.TextBoxFor(m => m.Priority, new { @class = "form-control", @type = "number", @min = "0" })
			</div>
		</div>
	</div>
}
<script>
	$(document).ready(function () {
	});
</script>