@model EcommerceASP.ViewModel.Topic.TopicViewBO
@using EcommerceASP.ViewModel.Component
@{
	Layout = "~/Views/Shared/_LayoutBee.cshtml";
}

@{
	ViewBag.Title = Model.Title;

}
<section id="top-content-area" class="tca-medium tca-text-center" style="background-image: url('https://topdesign.com.vn/wp-content/uploads/2023/06/hien-dai-1-jpg-e1686131962313.webp')">
	<div class="overlay" style="opacity: 0.3; background-color: #444444;"></div><div class="lines-overlay animated fadeInDown"></div><div class="container">
		<div class="row">
			<div class="col-md-12">
				<div class="title-content"> <h1 class="page-title animated fadeInDown" style="font-size: 3em;">Tổng hợp các mẫu thiết kế biệt thự 3 tầng đẹp, hiện đại, sang trọng 2023</h1></div>
			</div>
		</div>
	</div>
</section>
@{
	Html.RenderPartial(Url.Content("Components/_Top_Breadcrumb"), new BreadcrumbBO
	{
		ParentSlugName = Model.ParentSlugName,
		ParentSlug = Model.ParentSlug,
		SlugName = Model.SlugName,
		Slug = Model.Slug,
		IsChild = Model.IsChild,
		Title = Model.Title,
		IsShowTitle = true
	});
}

<div class="container">
	@Html.Raw(Model.Content)
</div>


