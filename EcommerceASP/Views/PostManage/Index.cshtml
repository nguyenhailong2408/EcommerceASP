@model EcommerceASP.ViewModel.PostManage.SearchFormViewModel
@{
	Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
@{
	ViewBag.Title = "Quản lý chủ đề bài viết";
}
@section Scripts{
	<script src="~/Scripts/Admin/PostManage.js"></script>
}

<div class="box box-success">
	<div class="box-header with-border">
		<div class="col-sm-12 col-md-3">
			<div class="row">
				<h3 class="box-title">Quản lý chủ đề bài viết</h3>
			</div>
		</div>
	</div><!-- /.box-header -->
	<div class="box-body">
		@{Html.RenderPartial("Component/_SearchForm", Model);}
	</div><!-- /.box-body -->
</div><!-- /.box -->

<div class="row">
	<div class="col-sm-12">
		<div class="box box-info">
			<div class="box-header with-border">
				<div class="col-sm-12 col-md-6">
					<div class="row">
						<h3 class="box-title">Danh sách chủ đề bài viết</h3>
					</div>
				</div>
			</div><!-- /.box-header -->
			<div class="box-body" id="list-data" @*style="overflow-x: scroll;"*@>

			</div><!-- /.box-body -->
		</div><!-- /.box -->
	</div>
</div>
@{
	Html.RenderPartial("Components/_ModalUpdate");
}
<script>
	$(document).ready(function () {
		Common.PostManage = new PostManage();
		Common.PostManage.SubmitForm();
		PostManage.Url = {};
		PostManage.Url.FormUpdate = '@Url.Action("Dialog","PostManage")';
		PostManage.Url.Delete = '@Url.Action("Delete", "PostManage")';
	});
</script>