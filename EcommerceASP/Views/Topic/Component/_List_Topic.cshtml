@using EcommerceASP.Libraries.MvcPaging
@model EcommerceASP.ViewModel.Topic.TopicViewBO

@{
	if (Model != null)
	{
		<section class="container">
			<div class="row news-content">
				@{
					foreach (var item in Model.lstTopicDetail)
					{
						<div class="col-lg-3 col-md-3 col-sm-6 col-xs-6 col-6 news-item">
							<div class="news-item__block item-block">
								<div class="item-block__img-thumb">
									<a href="/@item.Slug"><img src="~/Content/Images/topic/@item.ThumbnailImage" alt="@item.Title" /></a>
								</div>
								<div class="item-block__topic-info">
									<a href="/@item.Slug"><span class="topic-info__title">@item.Title</span></a>
									<span class="topic-info__desc">@Html.Raw(item.Description)</span>
								</div>
							</div>
						</div>
					}

				}
				<div class="col-md-12" style="display:flex;justify-content:center;">
					<div class="row">
						<div class="paging-top clearfix">
							@if (Model?.lstTopicDetail != null && Model.lstTopicDetail.Count() > 0)
							{
								@Html.Raw(Ajax.Pager(
								new Options
								{
									PageSize = Model.lstTopicDetail.PageSize,
									TotalItemCount = Model.lstTopicDetail.TotalItemCount,
									CurrentPage = Model.lstTopicDetail.PageNumber,
									IsShowControls = true,
									IsShowFirstLast = true,
									IsShowPrevNext = true,
									LimitPage = 7,
									Link = "/" + Model.ParentSlug + "?page={0}",
									//OnClick = "Common.Product.Paging({0})"
								}, null, null));
							}
						</div>
					</div>
				</div>
			</div>
		</section>

	}
}

