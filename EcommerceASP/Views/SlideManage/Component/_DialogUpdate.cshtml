@model EcommerceASP.ViewModel.SlideManage.SlideManageBO
@{
	var controlDev = false;
}
@using (Ajax.BeginForm("Update", "SlideManage", null, new AjaxOptions()
{
	HttpMethod = "POST",
	OnBegin = "Common.SlideManage.UpdateBeforeSend",
	OnSuccess = "Common.SlideManage.UpdateSuccess"
},
new
{
	@id = "form-update",
	@class = "form-horizontal multiple-controls",
	@enctype = "multipart/form-data"
}))
{
	<div class="hidden">
		@Html.HiddenFor(m => m.Id)
		@Html.AntiForgeryToken()
	</div>
	<div class="col-md-12 container">
		<div class="row form-group">
			<label class="control-label col-md-2">Tiêu đề:</label>
			<div class="col-md-10">
				@Html.TextBoxFor(m => m.Name, new { @class = "form-control", @maxLength = "150", @style = "height:30px" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2">Đường dẫn:</label>
			<div class="col-md-10">
				@Html.TextBoxFor(m => m.Slug, new
		   {
			   @class = "form-control",
			   @maxLength = "150",
			   @style = "height:30px",
			   @onblur = "Common.SlideManage.OnBlurInputSlug(this)"
		   })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2">Trang:</label>
			<div class="col-md-10">
				@Html.DropDownList("PageId", EcommerceASP.Queries.CommonQuery.GetListPage(0), new { @class = "form-control", @readonly = "readonly" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2 ">Hình</label>
			<div class="col-md-9">
				<div class="input-group">
					<img id="imgShow" src="@Url.Content($"~/Content/Images/slide/{Model.Image}")" alt="@Model.Name" height="50" />
				</div>
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2 ">Upload Images</label>
			<div class="col-md-9">
				<div class="input-group">
					@Html.TextBoxFor(m => m.Image, new { @class = "form-control", @readonly = "readonly" })
					@Html.HiddenFor(m => m.ImageOld)
					<label class="input-group-addon cursor" for="file-upload-image">
						<i class="fa fa-upload"></i>
					</label>
				</div>
				<input type="file" id="file-upload-image" name="UploadImage" class="d-none" />
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2">Thứ tự:</label>
			<div class="col-md-10">
				@Html.TextBoxFor(m => m.Priority, new { @class = "form-control", @type = "number", @min = "0" })
			</div>
		</div>
	</div>
}