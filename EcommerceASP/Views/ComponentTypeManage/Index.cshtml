@model EcommerceASP.ViewModel.ComponentTypeManage.SearchFormViewModel
@{
	Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
@{
	ViewBag.Title = "Quản lý slide";
}
@section Scripts{
	<script src="~/Scripts/Admin/ComponentTypeManage.js"></script>
}

<div class="box box-success">
	<div class="box-header with-border">
		<div class="col-sm-12 col-md-3">
			<div class="row">
				<h3 class="box-title">Quản lý loại module</h3>
			</div>
		</div>
	</div><!-- /.box-header -->
	<div class="box-body">
		@{Html.RenderPartial("Component/_SearchForm", Model);}
	</div><!-- /.box-body -->
</div><!-- /.box -->

<div class="row">
	<div class="col-sm-12">
		<div class="box box-info">
			<div class="box-header with-border">
				<div class="col-sm-12 col-md-6">
					<div class="row">
						<h3 class="box-title">Danh sách loại module</h3>
					</div>
				</div>
			</div><!-- /.box-header -->
			<div class="box-body" id="list-data" @*style="overflow-x: scroll;"*@>

			</div><!-- /.box-body -->
		</div><!-- /.box -->
	</div>
</div>
@{
	Html.RenderPartial("Components/_ModalUpdate");
}
<script>
	$(document).ready(function () {
		Common.ComponentTypeManage = new ComponentTypeManage();
		Common.ComponentTypeManage.SubmitForm();
		ComponentTypeManage.Url = {};
		ComponentTypeManage.Url.FormUpdate = '@Url.Action("Dialog","ComponentTypeManage")';
		ComponentTypeManage.Url.Delete = '@Url.Action("Delete", "ComponentTypeManage")';
		ComponentTypeManage.Url.GetPageBySlug = '@Url.Action("GetPageBySlug", "Common")';
	});
</script>