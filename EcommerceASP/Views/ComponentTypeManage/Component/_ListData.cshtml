@model EcommerceASP.ViewModel.ComponentTypeManage.ListViewModel
@using EcommerceASP.Libraries.MvcPaging
<style>
	.line-camp-3 {
		overflow: hidden;
		text-overflow: ellipsis;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
	}
</style>
<table class="table table-striped table-hover table-bordered table-sorter" style="margin-bottom:0;" id="table-list-ComponentTypeManage">
	<thead>
		<tr>
			<th class="text-center" width="50">STT</th>
			<th class="text-center">Tiêu đề</th>
			<th class="text-center">Tên file</th>
			<th class="text-center">Mô tả</th>
			<th class="text-center">Mô tả bằng hình ảnh</th>
			<th class="text-center">Dạng slide</th>
			<th class="text-center">Số dòng</th>
			<th class="text-center">Số cột</th>
			<th class="text-center">Ngày tạo</th>
			<th class="text-center">Người tạo</th>
			<th class="text-center">#</th>
		</tr>
	</thead>
	<tbody>
		@if (Model.Items != null && Model.Items.Count() > 0)
		{
			var i = 1;
			foreach (var item in Model.Items)
			{
				<tr class="cursor" data-id="@item.Id">
					<td class="text-center">@i</td>
					<td>@item.Name</td>
					<td>@item.NameFile</td>
					<td>@item.Description</td>
					<td class="text-center">
						<img src="@Url.Content($"~/Content/Images/component/{item.DescriptionImage}")" alt="@item.Name" height="50" />
					</td>
					<td class="text-center">@Html.CheckBox("IsSlide",item.IsSlide)</td>
					<td class="text-center">@item.Row</td>
					<td class="text-center">@item.Collumn</td>
					<td class="text-center">@item.Created_at</td>
					<td class="text-center">@item.CreatedByName</td>
					<td class="text-center">
						<i class="fa fa-edit green" data-toggle="modal" data-target="#modal-update" data-backdrop="static"></i>&nbsp;
						<i class="fa fa-trash red deleted"></i>&nbsp;
					</td>

				</tr>
				i++;
			}
		}
		else
		{
			<tr class="noresult">
				<td colspan="11">Không có dữ liệu</td>
			</tr>
		}
	</tbody>
</table>
<div class="col-md-12 mt-2">
	<div class="row">
		<div class="paging-top clearfix">
			@if (Model.Items != null && Model.Items.Count() > 0)
			{
				@Html.Raw(Ajax.Pager(
				new Options
				{
					PageSize = Model.Items.PageSize,
					TotalItemCount = Model.Items.TotalItemCount,
					CurrentPage = Model.Items.PageNumber,
					IsShowControls = true,
					IsShowFirstLast = true,
					LimitPage = 7,
					Link = "javascript:void(0);",
					OnClick = "Common.ComponentTypeManage.Paging({0})"
				}, null, null));
			}
		</div>
	</div>
</div>

