@model EcommerceASP.ViewModel.ComponentTypeManage.SearchFormViewModel

@using (Ajax.BeginForm("GetList", "ComponentTypeManage", null,
									new AjaxOptions
									{
										HttpMethod = "POST",
										OnBegin = "Common.ComponentTypeManage.BeforeSend",
										OnSuccess = "Common.ComponentTypeManage.SuccessForm",
										UpdateTargetId = "list-data"
									}, new { @id = "form-search-ComponentTypeManage", @class = "form-horizontal multiple-controls", @style = "display:flex;flex-wrap:wrap" }))
{
	<div class="hidden">
		@Html.HiddenFor(m => m.PageCurrent)
	</div>
	<div class="col-sm-3 d-flex align-items-center flex-wrap p-0 mb-1">
		<label class="col-sm-3 control-label p-0">Tên module:</label>
		<div class="col-sm-9 p-0">
			@Html.TextBoxFor(m => m.Name, null, new { @class = "w-100 form-control", @placeholder = "Tên loại module" })
		</div>
	</div>
	<div class="col-sm-3 d-flex align-items-center flex-wrap p-0 mb-1">
		<label class="col-sm-3 control-label p-0">Mô tả:</label>
		<div class="col-sm-9 p-0">
			@Html.TextBoxFor(m => m.Description, null, new { @class = "w-100 form-control", @placeholder = "Mô tả" })
		</div>
	</div>
	<div class="col-sm-12 text-right">
		<button type="button" class="btn btn-danger btn-cons btn-sm" data-toggle="modal" data-target="#modal-update" data-backdrop="static" onclick="Common.ComponentTypeManage.ShowDialog()">
			<i class="fa fa-plus fa-lg"></i> &nbsp; Thêm mới
		</button>
		<button type="submit" class="btn btn-primary btn-sm">
			<i class="fa fa-search fa-lg"></i> &nbsp; Tìm kiếm
		</button>
		<button type="reset" class="btn btn-default btn-sm" @*onclick="Common.DialogTheme.Reset()"*@>
			<i class="fa fa-refresh fa-lg"></i> &nbsp; Xóa
		</button>
	</div>
}

