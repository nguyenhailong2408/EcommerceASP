@model EcommerceASP.ViewModel.ProductManage.SearchFormViewModel
@{
	Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
@{
	ViewBag.Title = "Quản lý sản phẩm";
}
@section Scripts{
	<script src="~/Scripts/Admin/ProductManage.js"></script>
}

<div class="box box-success">
	<div class="box-header with-border">
		<div class="col-sm-12 col-md-3">
			<div class="row">
				<h3 class="box-title">Thông tin tìm kiếm</h3>
			</div>
		</div>
	</div><!-- /.box-header -->
	<div class="box-body">
		@{Html.RenderPartial("Component/_SearchForm", Model);}
	</div><!-- /.box-body -->
</div><!-- /.box -->

<div class="row">
	<div class="col-sm-12">
		<div class="box box-info">
			<div class="box-header with-border">
				<div class="col-sm-12 col-md-6">
					<div class="row">
						<h3 class="box-title">Danh sách sản phẩm</h3>
					</div>
				</div>
			</div><!-- /.box-header -->
			<div class="box-body" id="list-data" @*style="overflow-x: scroll;"*@>

			</div><!-- /.box-body -->
		</div><!-- /.box -->
	</div>
</div>
@{
	Html.RenderPartial("Components/_ModalUpdate");
}
<script>
	$(document).ready(function () {
		Common.ProductManage = new ProductManage();
		Common.ProductManage.SubmitForm();
		ProductManage.Url = {};
		ProductManage.Url.FormUpdate = '@Url.Action("Dialog","ProductManage")';
		ProductManage.Url.GetActionController = '@Url.Action("GetActionController", "Common")';
		ProductManage.Url.GetProductCategoryDetail = '@Url.Action("GetProductCategoryDetail", "Common")';
		ProductManage.Url.Delete = '@Url.Action("Delete", "ProductManage")';
		ProductManage.Url.CheckExistSlug = '@Url.Action("CheckExistSlug", "Common")';
	});
</script>