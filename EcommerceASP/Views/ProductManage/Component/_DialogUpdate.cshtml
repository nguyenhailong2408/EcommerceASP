@model EcommerceASP.ViewModel.ProductManage.ProductManageBO
@{
	var controlDev = EcommerceASP.Constaint.Common.ControlCKEditor;
}
@using (Ajax.BeginForm("Update", "ProductManage", null, new AjaxOptions()
{
	HttpMethod = "POST",
	OnBegin = "Common.ProductManage.UpdateBeforeSend",
	OnSuccess = "Common.ProductManage.UpdateSuccess"
},
new
{
	@id = "form-update",
	@class = "form-horizontal multiple-controls",
	@enctype = "multipart/form-data"
}))
{
	<div class="hidden">
		@Html.HiddenFor(m => m.Id)
		@Html.AntiForgeryToken()
	</div>
	<div class="col-md-12 container">
		<div class="row form-group">
			<div class="col-md-6 d-flex flex-wrap">
				<label class="control-label col-md-3 font-weight-bold">Tên sản phẩm: <span style="color:red;">(*)</span></label>
				<div class="col-md-9">
					@Html.TextBoxFor(m => m.Name, new { @class = "form-control", @maxLength = "150", @style = "height:30px" })
				</div>
			</div>
			<div class="col-md-6 d-flex flex-wrap">
				<label class="control-label col-md-3 font-weight-bold">Đường dẫn: <span style="color:red;">(*)</span></label>
				<div class="col-md-9">
					@Html.TextBoxFor(m => m.Slug, new
					{
						@class = "form-control",
						@maxLength = "150",
						@style = "height:30px",
						@onblur = "Common.ProductManage.OnBlurInputSlug(this)"
					})
					<span id="text-alert" class="text-danger"></span>
				</div>
				
			</div>
		</div>
		<div class="row form-group">
			<div class="col-md-6 d-flex flex-wrap">
				<label class="control-label col-md-3 font-weight-bold">Hình: <span style="color:red;">(*)</span></label>
				<div class="col-md-9">
					<div class="input-group">
						<img id="imgShow" src="@Url.Content($"~/Content/Images/product/{Model.Image}")" alt="@Model.Image" height="50" />
					</div>
				</div>
			</div>
			<div class="col-md-6 d-flex flex-wrap">
				<label class="control-label col-md-3 font-weight-bold">Upload Hình: <span style="color:red;">(*)</span></label>
				<div class="col-md-9">
					<div class="input-group">
						@Html.TextBoxFor(m => m.Image, new { @class = "form-control", @readonly = "readonly" })
						@Html.HiddenFor(m => m.ImageOld)
						<label class="input-group-addon cursor" for="file-upload-image">
							<i class="fa fa-upload"></i>
						</label>
					</div>
					<input type="file" id="file-upload-image" name="UploadImage" class="d-none" />
				</div>
			</div>
		</div>
		<div class="row form-group">
			<div class="col-md-6 d-flex flex-wrap">
				<label class="control-label col-md-3 font-weight-bold">Danh mục cha:</label>
				<div class="col-md-9">
					@Html.DropDownListFor(m => m.ProductCategoryId,
											   EcommerceASP.Queries.CommonQuery.GetListProductCategory(Model.ProductCategoryId),
											   "-- Chưa chọn danh mục cha --",
											   new
													{
												   @class = "form-control",
												   @maxLength = "150",
												   @style = "height:30px",
												   @onchange = "Common.ProductManage.OnChangeSelectProductCategory(this)"
											   })
				</div>
			</div>
			<div class="col-md-6 d-flex flex-wrap">
				<label class="control-label col-md-3 font-weight-bold">Danh mục con:</label>
				<div class="col-md-9">
					@Html.DropDownListFor(m => m.ProductCategoryDetailId,
											   EcommerceASP.Queries.CommonQuery.GetListProductCategoryDetailChild(Model.ProductCategoryId, Model.ProductCategoryDetailId),
											   "-- Chưa chọn danh mục con --",
											   new
													{
												   @class = "form-control",
												   @maxLength = "150",
												   @style = "height:30px",
												   @id = "inputUpdateProductDetail"
											   })
				</div>
			</div>
		</div>


		<div class="row form-group">
			<label class="control-label col-md-1 font-weight-bold">Thông tin:</label>
			<div class="col-md-11">
				@Html.TextAreaFor(m => m.Infomation, new { @class = "form-control", @rows = "5" })
				@{
					if (controlDev)
					{
						<script>
							CKEDITOR.replace("Infomation", {
									extraPlugins: 'image2,uploadimage',

									toolbar: [{
										name: 'clipboard',
										items: ['Undo', 'Redo']
									},
									{
										name: 'styles',
										items: ['Styles', 'Format']
									},
									{
										name: 'basicstyles',
										items: ['Bold', 'Italic', 'Strike', '-', 'RemoveFormat']
									},
									{
										name: 'paragraph',
										items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote']
									},
									{
										name: 'links',
										items: ['Link', 'Unlink']
									},
									{
										name: 'insert',
										items: ['Image', 'Table']
									},
									{
										name: 'tools',
										items: ['Maximize']
									},
									{
										name: 'editing',
										items: ['Scayt']
									}
									],

									// Configure your file manager integration. This example uses CKFinder 3 for PHP.
									filebrowserBrowseUrl: '/apps/ckfinder/3.4.5/ckfinder.html',
									filebrowserImageBrowseUrl: '@Url.Content("~/Content/Images/productContent")',
									filebrowserUploadUrl: '@Url.Action("UploadImageProduct", "Common")',
									filebrowserImageUploadUrl: '@Url.Action("UploadImageProduct", "Common")',

									// Upload dropped or pasted images to the CKFinder connector (note that the response type is set to JSON).
									uploadUrl: '@Url.Action("UploadImageProduct", "Common")',

									// Reduce the list of block elements listed in the Format drop-down to the most commonly used.
									format_tags: 'p;h1;h2;h3;pre',
									// Simplify the Image and Link dialog windows. The "Advanced" tab is not needed in most cases.
									removeDialogTabs: 'image:advanced;link:advanced',

									height: 300,
									removeButtons: 'PasteFromWord',
							});
						</script>
					}
					else
					{
						<script>
							CKEDITOR.replace("Infomation", {
								filebrowserBrowseUrl: '#',
								filebrowserUploadUrl: '@Url.Action("UploadImageProduct", "Common")',
							});
						</script>
					}
				}
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-1 font-weight-bold">Mô tả:</label>
			<div class="col-md-11">
				@Html.TextAreaFor(m => m.Description, new { @class = "form-control", @rows = "5" })
				@{
					if (controlDev)
					{
						<script>
							CKEDITOR.replace("Description", {
									extraPlugins: 'image2,uploadimage',

									toolbar: [{
										name: 'clipboard',
										items: ['Undo', 'Redo']
									},
									{
										name: 'styles',
										items: ['Styles', 'Format']
									},
									{
										name: 'basicstyles',
										items: ['Bold', 'Italic', 'Strike', '-', 'RemoveFormat']
									},
									{
										name: 'paragraph',
										items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote']
									},
									{
										name: 'links',
										items: ['Link', 'Unlink']
									},
									{
										name: 'insert',
										items: ['Image', 'Table']
									},
									{
										name: 'tools',
										items: ['Maximize']
									},
									{
										name: 'editing',
										items: ['Scayt']
									}
									],

									// Configure your file manager integration. This example uses CKFinder 3 for PHP.
									filebrowserBrowseUrl: '/apps/ckfinder/3.4.5/ckfinder.html',
									filebrowserImageBrowseUrl: '@Url.Content("~/Content/Images/productContent")',
									filebrowserUploadUrl: '@Url.Action("UploadImageProduct", "Common")',
									filebrowserImageUploadUrl: '@Url.Action("UploadImageProduct", "Common")',

									// Upload dropped or pasted images to the CKFinder connector (note that the response type is set to JSON).
									uploadUrl: '@Url.Action("UploadImageProduct", "Common")',

									// Reduce the list of block elements listed in the Format drop-down to the most commonly used.
									format_tags: 'p;h1;h2;h3;pre',
									// Simplify the Image and Link dialog windows. The "Advanced" tab is not needed in most cases.
									removeDialogTabs: 'image:advanced;link:advanced',

									height: 300,
									removeButtons: 'PasteFromWord',
							});
						</script>
					}
					else
					{
						<script>
							CKEDITOR.replace("Description", {
								filebrowserBrowseUrl: '#',
								filebrowserUploadUrl: '@Url.Action("UploadImageProduct", "Common")',
							});
						</script>
					}
				}
			</div>
		</div>
	</div>
}
<script>
	$(document).ready(function () {
		$("#idpage").off('select2:select').select2();
	});
</script>