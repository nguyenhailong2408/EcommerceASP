@model EcommerceASP.ViewModel.CategoryDetailManage.ListViewModel
@using EcommerceASP.Libraries.MvcPaging
<style>
	.line-camp-3 {
		overflow: hidden;
		text-overflow: ellipsis;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
	}
</style>
<table class="table table-striped table-hover table-bordered table-sorter" style="margin-bottom:0;" id="table-list-CategoryDetailManage">
	<thead>
		<tr>
			<th class="text-center" width="50">STT</th>
			<th class="text-center">Danh mục cha</th>
			<th class="text-center">Cha</th>
			<th class="text-center">Tên danh mục</th>
			<th class="text-center">Đường dẫn</th>
			<th class="text-center">Có hình</th>
			<th class="text-center">Hình</th>
			<th class="text-center">Thứ tự</th>
			<th class="text-center">Trang</th>
			<th class="text-center">Ngày tạo</th>
			<th class="text-center">Người tạo</th>
			<th class="text-center">#</th>
		</tr>
	</thead>
	<tbody>
		@if (Model.Items != null && Model.Items.Count() > 0)
		{
			var i = 1;
			foreach (var item in Model.Items)
			{
				<tr class="cursor" data-id="@item.Id">
					<td class="text-center">@i</td>
					<td class="text-left">@item.CategoryID - @item.CategoryName</td>
					<td class="text-left">@item.ParentId - @item.ParentName</td>
					<td class="text-left">@item.Id - @item.Name</td>
					<td class="text-left"><a href="/@item.Slug" target="_blank">@item.Slug</a></td>

					<td class="text-center">@Html.CheckBox("cbHasBanner", item.IsHasBanner, new { @readonly = "readonly" })</td>
					<td class="text-center">
						@{
							if (item.IsHasBanner)
							{
								<img src="@Url.Content($"~/Content/Images/banner/{item.BannerImage}")" alt="@item.Name" height="50" />
							}
						}
					</td>
					<td class="text-center">@item.Priority</td>
					<td class="text-center">@item.PageInfo</td>
					<td class="text-center">@item.Created_at</td>

					<td class="text-center">@item.CreatedByName</td>
					<td class="text-center">
						<i class="fa fa-edit green" data-toggle="modal" data-target="#modal-update" data-backdrop="static"></i>&nbsp;
						<i class="fa fa-trash red deleted"></i>&nbsp;
					</td>

				</tr>
				i++;
			}
		}
		else
		{
			<tr class="noresult">
				<td colspan="12">Không có dữ liệu</td>
			</tr>
		}
	</tbody>
</table>
<div class="col-md-12 mt-2">
	<div class="row">
		<div class="paging-top clearfix">
			@if (Model.Items != null && Model.Items.Count() > 0)
			{
				@Html.Raw(Ajax.Pager(
				new Options
				{
					PageSize = Model.Items.PageSize,
					TotalItemCount = Model.Items.TotalItemCount,
					CurrentPage = Model.Items.PageNumber,
					IsShowControls = true,
					IsShowFirstLast = true,
					LimitPage = 7,
					Link = "javascript:void(0);",
					OnClick = "Common.CategoryDetailManage.Paging({0})"
				}, null, null));
			}
		</div>
	</div>
</div>

