@model EcommerceASP.ViewModel.PageSlug.SearchFormViewModel
@{
	Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
@{
	ViewBag.Title = "Index";
}
@section Scripts{
	@*<script src="https://cdn.ckeditor.com/4.20.0/standard-all/ckeditor.js"></script>*@
	<script src="~/Scripts/Admin/PageSlug.js"></script>
}

<div class="box box-success">
	<div class="box-header with-border">
		<div class="col-sm-12 col-md-3">
			<div class="row">
				<h3 class="box-title">Thông tin tìm kiếm</h3>
			</div>
		</div>
	</div><!-- /.box-header -->
	<div class="box-body">
		@{Html.RenderPartial("Component/_SearchForm", Model);}
	</div><!-- /.box-body -->
</div><!-- /.box -->

<div class="row">
	<div class="col-sm-12">
		<div class="box box-info">
			<div class="box-header with-border">
				<div class="col-sm-12 col-md-6">
					<div class="row">
						<h3 class="box-title">Danh sách đường dẫn</h3>
					</div>
				</div>
			</div><!-- /.box-header -->
			<div class="box-body" id="list-data">

			</div><!-- /.box-body -->
		</div><!-- /.box -->
	</div>
</div>
@{
	Html.RenderPartial("Components/_ModalUpdate");
}
<script>
	$(document).ready(function () {
		Common.PageSlug = new PageSlug();
		Common.PageSlug.SubmitForm();
		PageSlug.Url = {};
		PageSlug.Url.FormUpdate = '@Url.Action("Dialog","PageSlug")';
		PageSlug.Url.GetActionController = '@Url.Action("GetActionController", "Common")';
	});
</script>