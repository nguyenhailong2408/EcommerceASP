@model EcommerceASP.ViewModel.PageSlug.ListViewModel
@using EcommerceASP.Libraries.MvcPaging

<table class="table table-striped table-hover table-bordered table-sorter" style="margin-bottom:0;" id="table-list-PageSlug">
	<thead>
		<tr>
			<th class="text-center" width="50">STT</th>
			<th class="text-center">Đường dẫn</th>
			<th class="text-center">Trang</th>
			<th class="text-center">Action</th>
			<th class="text-center">Controller</th>
			<th class="text-center">Ngày tạo</th>
			<th class="text-center">Người tạo</th>
			<th class="text-center">#</th>
		</tr>
	</thead>
	<tbody>
		@if (Model.Items != null && Model.Items.Count() > 0)
		{
			var i = 1;
			foreach (var item in Model.Items)
			{
				<tr class="cursor" data-id="@item.Id">
					<td class="text-center">@i</td>
					<td><a href="/@item.Slug" target="_blank">@item.Slug</a></td>
					<td>@item.PageId - @item.PageName</td>
					<td class="text-center">@item.Action</td>
					<td class="text-center">@item.Controller</td>
					<td class="text-center">@item.Created_at</td>
					<td class="text-center">@item.Created_by</td>
					<td class="text-center">
						@*<button type="button" class="btn btn-danger" data-toggle="modal" data-target="#glassAnimals" data-backdrop="static">
								Glass Animals Info
							</button>*@
						<i class="fa fa-edit green" data-toggle="modal" data-target="#modal-update" data-backdrop="static"></i>&nbsp;
						<i class="fa fa-trash red deleted"></i>&nbsp;
					</td>

				</tr>
				i++;
			}
		}
		else
		{
			<tr class="noresult">
				<td colspan="8">Không có dữ liệu</td>
			</tr>
		}
	</tbody>
</table>
<div class="col-md-12 mt-2">
	<div class="row">
		<div class="paging-top clearfix">
			@if (Model.Items != null && Model.Items.Count() > 0)
			{
				@Html.Raw(Ajax.Pager(
				new Options
				{
					PageSize = Model.Items.PageSize,
					TotalItemCount = Model.Items.TotalItemCount,
					CurrentPage = Model.Items.PageNumber,
					IsShowControls = true,
					IsShowFirstLast = true,
					LimitPage = 7,
					Link = "javascript:void(0);",
					OnClick = "Common.PageSlug.Paging({0})"
				}, null, null));
			}
		</div>
	</div>
</div>

