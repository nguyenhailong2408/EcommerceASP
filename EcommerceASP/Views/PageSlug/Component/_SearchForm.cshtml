@model EcommerceASP.ViewModel.PageSlug.SearchFormViewModel

@using (Ajax.BeginForm("GetList", "PageSlug", null,
									new AjaxOptions
									{
										HttpMethod = "POST",
										OnBegin = "Common.PageSlug.BeforeSend",
										OnSuccess = "Common.PageSlug.SuccessForm",
										UpdateTargetId = "list-data"
									}, new { @id = "form-search-PageSlug", @class = "form-horizontal multiple-controls", @style = "display:flex;flex-wrap:wrap" }))
{
	<div class="hidden">
		@Html.HiddenFor(m => m.PageCurrent)
	</div>
	<div class="col-sm-3 d-flex align-items-center flex-wrap p-0 mb-1">
		<label class="col-sm-3 control-label p-0">Trang:</label>
		<div class="col-sm-8 p-0">
			@Html.DropDownListFor(m => m.PageId, EcommerceASP.Queries.CommonQuery.GetListPage(Model.PageId), "==Tất cả==", new { @class = "" })
		</div>
	</div>
	<div class="col-sm-3 d-flex align-items-center flex-wrap p-0 mb-1">
		<label class="col-sm-3 control-label p-0">Đường dẫn:</label>
		<div class="col-sm-8 p-0">
			@Html.TextBoxFor(m => m.PageSlug, new { @class = "w-100", @id = "txtPageSlug" })
		</div>
	</div>
	<div class="col-sm-12 text-right">
		<button type="button" class="btn btn-danger btn-cons btn-sm" data-toggle="modal" data-target="#modal-update" data-backdrop="static" onclick="Common.PageSlug.ShowDialog()">
			<i class="fa fa-plus fa-lg"></i> &nbsp; Thêm mới
		</button>
		<button type="submit" class="btn btn-primary btn-sm">
			<i class="fa fa-search fa-lg"></i> &nbsp; Tìm kiếm
		</button>
		<button type="reset" class="btn btn-default btn-sm" @*onclick="Common.DialogTheme.Reset()"*@>
			<i class="fa fa-refresh fa-lg"></i> &nbsp; Xóa
		</button>
	</div>
}
<script>
	$(document).ready(function () {
		$("#PageId").off('select2:select').select2();
	});
</script>

