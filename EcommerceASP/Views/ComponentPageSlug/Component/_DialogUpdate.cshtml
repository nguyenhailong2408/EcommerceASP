@model EcommerceASP.ViewModel.ComponentPageSlug.ComponentPageSlugBO
@{
	var controlDev = false;
}
@using (Ajax.BeginForm("Update", "ComponentPageSlug", null, new AjaxOptions()
{
	HttpMethod = "POST",
	OnBegin = "Common.ComponentPageSlug.UpdateBeforeSend",
	OnSuccess = "Common.ComponentPageSlug.UpdateSuccess"
},
new
{
	@id = "form-update",
	@class = "form-horizontal multiple-controls",
	@enctype = "multipart/form-data"
}))
{
	<div class="hidden">
		@Html.HiddenFor(m => m.Id)
		@Html.AntiForgeryToken()
	</div>
	<div class="col-md-12 container">
		<div class="row form-group">
			<label class="control-label col-md-2">Link:</label>
			<div class="col-md-10">
				@{
					if (Model.Id == 0)
					{
						@Html.TextBoxFor(m => m.PageSlug, new { @class = "form-control", @maxLength = "150", @style = "height:30px" })
					}
					else
					{
						@Html.TextBoxFor(m => m.PageSlug, new { @class = "form-control", @maxLength = "150", @style = "height:30px", @readonly = "readonly" })
					}
				}

			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2">Tên:</label>
			<div class="col-md-10">
				@Html.TextBoxFor(m => m.Name, new { @class = "form-control", @maxLength = "150", @style = "height:30px" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2">Mô tả:</label>
			<div class="col-md-10">
				@Html.TextBoxFor(m => m.Title, new { @class = "form-control", @maxLength = "150", @style = "height:30px" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2">Loại module:</label>
			<div class="col-md-10">
				@Html.DropDownListFor(m => m.ComponentTypeId, EcommerceASP.Queries.CommonQuery.GetComponentType(Model.ComponentTypeId), null, new { @class = "w-100 form-control" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2">Thứ tự:</label>
			<div class="col-md-10">
				@Html.TextBoxFor(m => m.Priority, new { @class = "form-control", @type = "number", @min = "0" })
			</div>
		</div>
		@{
			if (Model.Id != 0)
			{
				<div class="row form-group">
					<div class="col-sm-12 text-right">
						<button type="button" class="btn btn-danger btn-cons btn-sm"
								data-toggle="modal"
								data-target="#modal-updateSubDescription"
								data-backdrop="static"
								onclick="Common.ComponentPageSlug.ShowDialogSubDescription(0, @Model.Id,'@Model.PageSlug')">
							<i class="fa fa-plus fa-lg"></i> &nbsp; Thêm mới
						</button>
						<button type="button" class="btn btn-success btn-sm"
								onclick="Common.ComponentPageSlug.GetDataSubDescription(@Model.Id)">
							<i class="fa fa-refresh fa-lg"></i>
						</button>
					</div>
				</div>
				<div class="row form-group" id="list-dataComponentSubDescription">
					@{
						Html.RenderPartial("Component/_ListDataSubDescription", Model.lstSubDesc);
					}
				</div>
			}
		}

	</div>
}
<script>
	ComponentID = @Model.Id;
</script>