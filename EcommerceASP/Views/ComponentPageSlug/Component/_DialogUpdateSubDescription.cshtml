@model EcommerceASP.ViewModel.ComponentPageSlug.ComponentSubDescriptionBO
@{
	var controlDev = false;
}
@using (Ajax.BeginForm("UpdateSubDescription", "ComponentPageSlug", null, new AjaxOptions()
{
	HttpMethod = "POST",
	OnBegin = "Common.ComponentPageSlug.UpdateBeforeSendSubDescription",
	OnSuccess = "Common.ComponentPageSlug.UpdateSuccessSubDescription"
},
new
{
	@id = "form-updateSubDescription",
	@class = "form-horizontal multiple-controls",
	@enctype = "multipart/form-data"
}))
{
	<div class="hidden">
		@Html.HiddenFor(m => m.Id)
		@Html.AntiForgeryToken()
	</div>
	<div class="col-md-12 container">
		<div class="row form-group">
			<label class="control-label col-md-2">Mã module:</label>
			<div class="col-md-10">
				@Html.TextBoxFor(m => m.ComponentId, new { @class = "form-control", @maxLength = "150", @style = "height:30px", @readonly = "readonly" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2">Đường dẫn:</label>
			<div class="col-md-10">
				@Html.TextBoxFor(m => m.PageSlug, new { @class = "form-control", @maxLength = "150", @style = "height:30px", @readonly = "readonly" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2">Tiêu đề phụ:</label>
			<div class="col-md-10">
				@Html.TextBoxFor(m => m.SubTitle, new { @class = "form-control", @maxLength = "150", @style = "height:30px" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2">Tiêu đề:</label>
			<div class="col-md-10">
				@Html.TextBoxFor(m => m.Title, new { @class = "form-control", @maxLength = "150", @style = "height:30px" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2 ">Hình</label>
			<div class="col-md-10">
				<div class="input-group">
					<img id="imgShow" src="@Url.Content($"~/Content/Images/component/{Model.Image}")" alt="" height="50" />
				</div>
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2">Link liên kết:</label>
			<div class="col-md-10">
				@Html.TextBoxFor(m => m.ReferenceLink, new { @class = "form-control", @maxLength = "150", @style = "height:30px" })
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2 ">Upload Images</label>
			<div class="col-md-10">
				<div class="input-group">
					@Html.TextBoxFor(m => m.Image, new { @class = "form-control" })
					@Html.HiddenFor(m => m.ImageOld)
					<label class="input-group-addon cursor" for="file-upload-image">
						<i class="fa fa-upload"></i>
					</label>
				</div>
				<input type="file" id="file-upload-image" name="UploadImage" class="d-none" />
			</div>
		</div>
		<div class="row form-group">
			<label class="control-label col-md-2">Mô tả:</label>
			<div class="col-md-10">
				@Html.TextAreaFor(m => m.Description, new { @class = "form-control", @rows = "15" })
				@{
					if (controlDev)
					{
						<script>
							var editor1 = CKEDITOR.replace("Description", {
								extraPlugins: 'image2,uploadimage',
								extraAllowedContent: 'div',
								toolbar: [{
									name: 'clipboard',
									items: ['Undo', 'Redo']
								},
								{
									name: 'styles',
									items: ['Styles', 'Format']
								},
								{
									name: 'basicstyles',
									items: ['Bold', 'Italic', 'Strike', '-', 'RemoveFormat']
								},
								{
									name: 'paragraph',
									items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote']
								},
								{
									name: 'links',
									items: ['Link', 'Unlink']
								},
								{
									name: 'insert',
									items: ['Image', 'Table']
								},
								{
									name: 'tools',
									items: ['Maximize']
								},
								{
									name: 'editing',
									items: ['Scayt']
								}
								],

								// Configure your file manager integration. This example uses CKFinder 3 for PHP.
								filebrowserBrowseUrl: '/apps/ckfinder/3.4.5/ckfinder.html',
								filebrowserImageBrowseUrl: '@Url.Content("~/Content/Images/component")',
								filebrowserUploadUrl: '@Url.Action("UploadImageComponent", "Common")',
								filebrowserImageUploadUrl: '@Url.Action("UploadImageComponent", "Common")',

								// Upload dropped or pasted images to the CKFinder connector (note that the response type is set to JSON).
								uploadUrl: '@Url.Action("UploadImageComponent", "Common")',

								// Reduce the list of block elements listed in the Format drop-down to the most commonly used.
								format_tags: 'p;h1;h2;h3;pre',
								// Simplify the Image and Link dialog windows. The "Advanced" tab is not needed in most cases.
								removeDialogTabs: 'image:advanced;link:advanced',

								height: 300,
								removeButtons: 'PasteFromWord',
							});
						</script>
					}
					else
					{
						<script>
							CKEDITOR.replace("Description", {
								filebrowserBrowseUrl: '#',
								filebrowserUploadUrl: '@Url.Action("UploadImageComponent", "Common")',
							});
						</script>
					}
				}
			</div>
		</div>
	</div>
}
