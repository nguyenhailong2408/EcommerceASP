@model List<EcommerceASP.ViewModel.ComponentPageSlug.ComponentSubDescriptionBO>

<table class="table table-striped table-hover table-bordered table-sorter" style="margin-bottom:0;">
	<thead>
		<tr>
			<th class="text-center" width="50">STT</th>
			<th class="text-center">Mã modun</th>
			<th class="text-center">Đường đãn</th>
			<th class="text-center">Tiêu đề phụ</th>
			<th class="text-center">Tiêu đề</th>
			<th class="text-center">Hình ảnh</th>
			<th class="text-center">Thứ tự</th>
			<th class="text-center" style="width:115px;">#</th>
		</tr>
	</thead>
	<tbody>
		@if (Model.Count() > 0)
		{
			var i = 1;
			foreach (var item in Model)
			{
				<tr class="cursor" data-id="@item.Id">
					<td class="text-center">@i</td>
					<td class="text-center">@item.Id</td>
					<td><a href="/@item.PageSlug" target="_blank">@item.PageSlug</a></td>
					<td>@item.SubTitle</td>
					<td>@item.Title</td>
					<td class="text-center">
						<img src="@Url.Content($"~/Content/Images/component/{item.Image}")" alt="" height="50" />
					</td>
					<td>@item.Priority</td>
					<td class="text-center">
						<button class="btn btn-sm btn-success"
								type="button"
								data-toggle="modal"
								data-target="#modal-updateSubDescription"
								data-backdrop="static"
								onclick="Common.ComponentPageSlug.ShowDialogSubDescription(@item.Id)">
							<i class="fa fa-edit"></i> Sửa
						</button>
						<button class="btn btn-sm btn-danger"
								type="button"
								data-toggle="modal"
								data-target="#modal-updateSubDescription"
								data-backdrop="static"
								onclick="Common.ComponentPageSlug.DeleteSubDescription(@item.Id)">
							<i class="fa fa-trash deleted"></i> Xóa
						</button>
					</td>

				</tr>
				i++;
			}
		}
		else
		{
			<tr class="noresult">
				<td colspan="7">Không có dữ liệu</td>
			</tr>
		}
	</tbody>
</table>
