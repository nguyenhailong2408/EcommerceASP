@model EcommerceASP.ViewModel.ComponentPageSlug.SearchFormViewModel
@{
	Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
@{
	ViewBag.Title = "Quản lý Modun theo đường dẫn";
}
@section Scripts{
	<script src="~/Scripts/Admin/ComponentPageSlug.js"></script>
}

<div class="box box-success">
	<div class="box-header with-border">
		<div class="col-sm-12 col-md-3">
			<div class="row">
				<h3 class="box-title">Quản lý module theo đường dẫn</h3>
			</div>
		</div>
	</div><!-- /.box-header -->
	<div class="box-body">
		@{Html.RenderPartial("Component/_SearchForm", Model);}
	</div><!-- /.box-body -->
</div><!-- /.box -->

<div class="row">
	<div class="col-sm-12">
		<div class="box box-info">
			<div class="box-header with-border">
				<div class="col-sm-12 col-md-6">
					<div class="row">
						<h3 class="box-title">Danh sách Module theo đường dẫn</h3>
					</div>
				</div>
			</div><!-- /.box-header -->
			<div class="box-body" id="list-data" @*style="overflow-x: scroll;"*@>

			</div><!-- /.box-body -->
		</div><!-- /.box -->
	</div>
</div>
@{
	Html.RenderPartial("Components/_ModalUpdate");
	Html.RenderPartial("Component/_ModalUpdateSubDescription");
}
<script>
	$(document).ready(function () {
		Common.ComponentPageSlug = new ComponentPageSlug();
		Common.ComponentPageSlug.SubmitForm();
		ComponentPageSlug.Url = {};
		ComponentPageSlug.Url.FormUpdate = '@Url.Action("Dialog","ComponentPageSlug")';
		ComponentPageSlug.Url.FormUpdateSubDescription = '@Url.Action("DialogSubDescription", "ComponentPageSlug")';
		ComponentPageSlug.Url.Delete = '@Url.Action("Delete", "ComponentPageSlug")';
		ComponentPageSlug.Url.GetPageBySlug = '@Url.Action("GetPageBySlug", "Common")';
		ComponentPageSlug.Url.GetComponentType = '@Url.Action("GetComponentType", "Common")';
		ComponentPageSlug.Url.GetDataSubDescription = '@Url.Action("GetDataSubDescription", "ComponentPageSlug")';
	});
</script>
